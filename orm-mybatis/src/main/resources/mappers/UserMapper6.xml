<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.mybatis.mapper.UserMapper6">

    <!--更新用户名-->
    <insert id="update">
        UPDATE t_user
        SET username = ${username}
        WHERE id = ${id}
