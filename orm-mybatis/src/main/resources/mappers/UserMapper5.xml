<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demo.mybatis.mapper.UserMapper5">

    <!--新增（获取自增ID），将自增ID封装到id属性里-->
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user
        VALUES (null, #{username}, #{password}, #{age}, #{sex}, #{email})
    </insert>

    <insert id="batchInsertUserList" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user VALUES
        <foreach collection="userDOList" separator="," item="user">
            (null, #{user.username}, #{user.password}, #{user.age}, #{user.sex}, #{user.email})
        </foreach>
    </insert>
</mapper>